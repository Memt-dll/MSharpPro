<Window x:Class="MSharpPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M#Pro" Icon="Assets/icon-64.png" Width="480" Height="270" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Çalarken çentikte zıplayan ekolayzer çubukları (düşük kare hızı = düşük CPU) -->
        <Storyboard x:Key="EqStoryboard" Timeline.DesiredFrameRate="24" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Eq1" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.42" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Eq2" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="1" To="0.35" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Eq3" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.45" To="0.95" Duration="0:0:0.36" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Eq4" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.8" To="0.25" Duration="0:0:0.48" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="EqBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Margin" Value="1.5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource AccentGradientV}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleY="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Çentik gizliyken ekranın en üstündeki görünmez algılama şeridi (alfa 1/255: görünmez ama fareyi yakalar) -->
        <Border x:Name="HotZone" Height="3" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#01000000" Visibility="Collapsed"/>

        <Border x:Name="Island" Width="170" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="0,0,16,16" ClipToBounds="True" BorderThickness="1,0,1,1" AllowDrop="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#07070F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#33FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>

                <!-- ============ Kapak resminden bulanık ortam arka planı ============ -->
                <Grid x:Name="AmbientLayer" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <Border x:Name="AmbientArt" CornerRadius="{Binding CornerRadius, ElementName=Island}" Opacity="0.8">
                        <Border.Background>
                            <ImageBrush x:Name="AmbientBrush" Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="{Binding CornerRadius, ElementName=Island}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#80000000" Offset="0"/>
                                <GradientStop Color="#C0000000" Offset="0.5"/>
                                <GradientStop Color="#EB000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Panel açıkken (kapak arka planı yoksa) üstte hafif beyaz parıltı -->
                <Border x:Name="GlowLayer" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.9">
                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                            <GradientStop Color="#08FFFFFF" Offset="0.55"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ============ KOMPAKT (çentik) ============ -->
                <Grid x:Name="CompactView" Margin="10,0,12,0">
                    <Border x:Name="CompactArtBox" Width="22" Height="22" CornerRadius="6"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="#26FFFFFF" Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="CompactArtGlyph" Text="&#xEC4F;" FontFamily="{StaticResource Icons}"
                                       FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Sağ taraf: sessiz simgesi her zaman görünür; yanında ya ekolayzer (çalarken) ya da nokta + hava durumu -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Mikrofon (turuncu) / kamera (yeşil) kullanımda -->
                        <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FF9F43" VerticalAlignment="Center"
                                 Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Mikrofon kullanımda"/>
                        <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Visibility="Collapsed" ToolTip="Kamera kullanımda"/>
                        <TextBlock x:Name="CompactMuted" Text="&#xE7ED;" FontFamily="{StaticResource Icons}" FontSize="11"
                                   Foreground="#FFB86B" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="CompactTimer" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="10.5"
                                       VerticalAlignment="Center" Margin="0,1,4,0" Foreground="#CCFFFFFF"/>
                            <TextBlock x:Name="CompactTimerText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    <StackPanel x:Name="EqPanel" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle x:Name="Eq1" Style="{StaticResource EqBar}"/>
                        <Rectangle x:Name="Eq2" Style="{StaticResource EqBar}"/>
                        <Rectangle x:Name="Eq3" Style="{StaticResource EqBar}"/>
                        <Rectangle x:Name="Eq4" Style="{StaticResource EqBar}"/>
                    </StackPanel>

                    <!-- Sağ taraf (müzik çalmıyorken): okunmamış bildirim noktası + hava durumu -->
                    <StackPanel x:Name="CompactRight" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="CompactDot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource AccentGradient}" Visibility="Collapsed"/>
                        <StackPanel x:Name="CompactWeather" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                            <Image x:Name="CompactWeatherIcon" Width="16" Height="16" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="CompactWeatherTemp" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>

                    <!-- Ortada saat -->
                    <TextBlock x:Name="CompactClock" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                </Grid>

                <!-- ============ KISA BİLDİRİM (peek) ============ -->
                <Grid x:Name="PeekView" Margin="12,10,18,12" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" BorderThickness="1.5"
                            BorderBrush="{StaticResource AccentGradient}" Background="#1AFFFFFF">
                        <Grid>
                            <TextBlock x:Name="PeekGlyph" FontFamily="{StaticResource Icons}" FontSize="18"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PeekTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PeekText" FontSize="12" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                        <!-- Ses / parlaklık düzeyi -->
                        <Grid x:Name="PeekLevel" Height="5" Margin="0,7,0,0" Visibility="Collapsed">
                            <Border Background="#24FFFFFF" CornerRadius="2.5"/>
                            <Border x:Name="PeekLevelFill" Background="White" CornerRadius="2.5" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ============ GENİŞ PANEL ============ -->
                <Grid x:Name="ExpandedView" Margin="16,10,16,14" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Bildirimleri sessize al -->
                            <Button x:Name="MuteBtn" Style="{StaticResource HeaderIconBtn}" Click="Mute_Click"
                                    ToolTip="Bildirimleri sessize al" Margin="0,0,6,0">
                                <TextBlock x:Name="MuteGlyph" Text="&#xEA8F;"/>
                            </Button>
                            <!-- Ayarlar penceresini açar -->
                            <Button Style="{StaticResource HeaderIconBtn}" Click="OpenAppSettings_Click"
                                    ToolTip="Ayarlar" Margin="0,0,10,0">
                                <TextBlock Text="&#xE713;"/>
                            </Button>
                            <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sekmeler: tek bir koyu yol içinde simge butonları (segmented control) -->
                        <Border Background="#14FFFFFF" CornerRadius="17" Padding="3" HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <StackPanel x:Name="TabBar" Orientation="Horizontal">
                                <RadioButton x:Name="TabMedia" Style="{StaticResource IconTab}" IsChecked="True" Tag="media"
                                             Checked="Tab_Checked" ToolTip="Müzik">
                                    <TextBlock Text="&#xEC4F;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabLyrics" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="lyrics" ToolTip="Şarkı sözleri">
                                    <TextBlock Text="&#xE8D2;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabBt" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="bt" ToolTip="Bluetooth">
                                    <TextBlock Text="&#xE702;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabTimer" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="timer" ToolTip="Zamanlayıcı">
                                    <TextBlock Text="&#xE916;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabCalendar" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="calendar" ToolTip="Takvim">
                                    <TextBlock Text="&#xE787;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabClipboard" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="clipboard" ToolTip="Kopyalananlar">
                                    <TextBlock Text="&#xE77F;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabShelf" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="shelf" ToolTip="Dosya rafı">
                                    <TextBlock Text="&#xE8B7;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabSystem" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="system" ToolTip="Sistem">
                                    <TextBlock Text="&#xE9D9;"/>
                                </RadioButton>
                                <RadioButton x:Name="TabNotif" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="notif" ToolTip="Bildirimler">
                                    <Grid Width="34" Height="28">
                                        <TextBlock Text="&#xEA8F;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="NotifBadge" Background="#FF4D6D" CornerRadius="7" MinWidth="14" Height="14"
                                                Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,2,0"
                                                BorderBrush="Black" BorderThickness="1.5" Visibility="Collapsed">
                                            <TextBlock x:Name="NotifBadgeText" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="TabWeather" Style="{StaticResource IconTab}" Checked="Tab_Checked"
                                             Tag="weather" ToolTip="Hava durumu">
                                    <Image x:Name="TabWeatherIcon" Width="17" Height="17" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,12,0,0">

                        <!-- Medya -->
                        <Grid x:Name="MediaPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Kapak: büyük, yuvarlak köşeli, ince açık kenarlı -->
                            <Border Width="112" Height="112" CornerRadius="22" Background="#1AFFFFFF" VerticalAlignment="Top"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="MediaArtGlyph" Text="&#xEC4F;" FontFamily="{StaticResource Icons}"
                                               FontSize="34" Foreground="{StaticResource AccentBrush}" Opacity="0.7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="21">
                                        <Border.Background>
                                            <ImageBrush x:Name="MediaArtBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" Margin="16,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Kaynak uygulama: küçük hap -->
                                <Border Background="#14FFFFFF" CornerRadius="9" Padding="7,2" HorizontalAlignment="Left"
                                        Margin="0,1,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MediaAppGlyph" Text="&#xE7F4;" FontFamily="{StaticResource Icons}"
                                                   FontSize="9.5" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                        <TextBlock x:Name="MediaApp" FontSize="10.5" Foreground="#B3FFFFFF"
                                                   TextTrimming="CharacterEllipsis" Text="Medya"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MediaTitle" Grid.Row="1" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Text="Şu anda çalan bir şey yok"/>
                                <TextBlock x:Name="MediaArtist" Grid.Row="2" FontSize="13" Foreground="#A6FFFFFF"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                                <!-- İlerleme: ince çubuk, süreler altında · Tıkla/sürükle: sar · Tekerlek: ±10 sn -->
                                <Grid x:Name="ProgressRow" Grid.Row="4" Margin="0,4,0,2" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="ProgressTrack" Height="14" Background="Transparent">
                                        <Border x:Name="TrackBg" Height="4" Background="#24FFFFFF" CornerRadius="2"
                                                VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressFill" Height="4" Background="White" CornerRadius="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                        <Ellipse x:Name="SeekKnob" Width="12" Height="12" Fill="White"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="PosText" FontSize="10" Foreground="#80FFFFFF" Text="0:00"/>
                                        <TextBlock x:Name="DurText" FontSize="10" Foreground="#80FFFFFF" Text="0:00"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Content="&#xE892;"
                                            FontSize="17" Click="Prev_Click" ToolTip="Önceki"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Content="&#xE768;"
                                            Click="PlayPause_Click" Margin="14,0" ToolTip="Oynat / Duraklat"/>
                                    <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Content="&#xE893;"
                                            FontSize="17" Click="Next_Click" ToolTip="Sonraki"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Bluetooth: her cihaz ayrı kart -->
                        <Grid x:Name="BtPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="BtList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="10" Background="{Binding IconBrush}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}"
                                                                   FontSize="14" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="11,0"
                                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="10" Padding="8,3"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                                       Foreground="#CCFFFFFF"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="BtEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#1AFFFFFF" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE702;" FontFamily="{StaticResource Icons}" FontSize="19"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Eşleştirilmiş Bluetooth cihazı yok" Foreground="#80FFFFFF"
                                           FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button Grid.Row="1" Style="{StaticResource PillBtn}" HorizontalAlignment="Right"
                                    Margin="0,2,0,0" Click="OpenBtSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBlock Text="Bluetooth ayarları"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Hava durumu -->
                        <Grid x:Name="WeatherPanel" Visibility="Collapsed">
                            <Grid x:Name="WeatherContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="172"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- Şu an: hava durumuna göre renklenen kart -->
                                <Border x:Name="WeatherCard" CornerRadius="18" Padding="14,10,12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE707;" FontFamily="{StaticResource Icons}" FontSize="9.5"
                                                       VerticalAlignment="Center" Margin="0,1,4,0"/>
                                            <TextBlock x:Name="WeatherCity" FontSize="11.5" FontWeight="SemiBold" MaxWidth="128"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Grid Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="WeatherTemp" FontSize="44" FontWeight="Light"
                                                       VerticalAlignment="Center" Margin="-2,-6,0,-4"/>
                                            <Image x:Name="WeatherIcon" Width="46" Height="46" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="WeatherCondition" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WeatherHiLo" FontSize="11" Foreground="#D9FFFFFF" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Önümüzdeki günler: gün · simge · en düşük · aralık çubuğu · en yüksek -->
                                <Grid Grid.Column="1" Margin="14,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ItemsControl x:Name="WeatherDays" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="27">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Image Grid.Column="1" Source="{Binding Icon}" Width="18" Height="18"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" FontSize="12" Foreground="#80FFFFFF"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Run Text="{Binding Min, Mode=OneWay}"/><Run Text="°"/>
                                                    </TextBlock>
                                                    <Grid Grid.Column="3" Height="4" Margin="8,0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding BarLeft}"/>
                                                            <ColumnDefinition Width="{Binding BarFill}"/>
                                                            <ColumnDefinition Width="{Binding BarRight}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="3" Background="#1FFFFFFF" CornerRadius="2"/>
                                                        <Border Grid.Column="1" CornerRadius="2">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#5AB8FF" Offset="0"/>
                                                                    <GradientStop Color="#FFD27A" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="4" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Run Text="{Binding Max, Mode=OneWay}"/><Run Text="°"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="WeatherDetail" Grid.Row="1" Style="{StaticResource Caption}" FontSize="10.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="WeatherEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Image x:Name="WeatherEmptyIcon" Width="40" Height="40" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WeatherProblem" Text="Ayarlar'dan şehrinizi seçin" Foreground="#99FFFFFF"
                                           FontSize="12" Margin="0,6,0,8" HorizontalAlignment="Center"/>
                                <Button Style="{StaticResource PillBtn}" Content="Ayarları aç" HorizontalAlignment="Center"
                                        Click="OpenAppSettings_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Şarkı sözleri: çalan satır ortada, öncesi / sonrası soluk -->
                        <Grid x:Name="LyricsPanel" Visibility="Collapsed">
                            <StackPanel x:Name="LyricsSynced" VerticalAlignment="Center">
                                <TextBlock x:Name="LyricPrev2" FontSize="12" Foreground="#40FFFFFF" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                <TextBlock x:Name="LyricPrev1" FontSize="13" Foreground="#73FFFFFF" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LyricNow" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="48"/>
                                <TextBlock x:Name="LyricNext1" FontSize="13" Foreground="#73FFFFFF" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                <TextBlock x:Name="LyricNext2" FontSize="12" Foreground="#40FFFFFF" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ScrollViewer x:Name="LyricsPlainBox" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                <TextBlock x:Name="LyricsPlain" FontSize="12.5" Foreground="#D9FFFFFF" TextWrapping="Wrap"
                                           TextAlignment="Center" LineHeight="19"/>
                            </ScrollViewer>
                            <StackPanel x:Name="LyricsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock x:Name="LyricsStatus" Foreground="#80FFFFFF" FontSize="12" Margin="0,6,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
                            </StackPanel>
                            <TextBlock Text="LRCLIB" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Opacity="0.6"/>
                        </Grid>

                        <!-- Zamanlayıcı / Pomodoro -->
                        <Grid x:Name="TimerPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0FFFFFFF" CornerRadius="18" Padding="16,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TimerPhase" Text="Zamanlayıcı" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#B3FFFFFF"/>
                                    <TextBlock x:Name="TimerBig" Grid.Row="1" Text="0:00" FontSize="40" FontWeight="Light"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Row="2" Height="4" Margin="0,0,0,10">
                                        <Border Background="#24FFFFFF" CornerRadius="2"/>
                                        <Border x:Name="TimerFill" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <Button x:Name="TimerPlayBtn" Style="{StaticResource PlayBtn}" Content="&#xE768;"
                                                Width="34" Height="34" FontSize="13" Click="TimerPlay_Click" ToolTip="Başlat / Duraklat"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE71A;" FontSize="13" Margin="8,0,0,0"
                                                Width="34" Height="34" Click="TimerStop_Click" ToolTip="Durdur"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Hızlı başlat" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                                <WrapPanel x:Name="TimerPresets">
                                    <Button Style="{StaticResource PillBtn}" Tag="1" Content="1 dk" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Tag="5" Content="5 dk" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Tag="10" Content="10 dk" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Tag="15" Content="15 dk" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Tag="30" Content="30 dk" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Tag="60" Content="1 sa" Margin="0,0,6,6" Click="TimerPreset_Click"/>
                                </WrapPanel>
                                <Button Style="{StaticResource PillBtn}" Content="+1 dk" HorizontalAlignment="Left" Margin="0,0,0,12"
                                        Click="TimerAdd_Click"/>
                                <Button Style="{StaticResource PillBtn}" HorizontalAlignment="Left" Click="Pomodoro_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                                        <TextBlock x:Name="PomodoroText" Text="Pomodoro"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Takvim -->
                        <Grid x:Name="CalendarPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="CalendarList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="4" CornerRadius="2" Background="#E9E8E1" Margin="0,2,10,2"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding When, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Location}" FontSize="10.5" Foreground="#73FFFFFF"
                                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding LocationVisibility}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#F2F1EB" CornerRadius="9" Padding="7,1"
                                                            VerticalAlignment="Center" Visibility="{Binding NowVisibility}">
                                                        <TextBlock Text="{Binding NowLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="#222622"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="CalendarEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock x:Name="CalendarProblem" Foreground="#80FFFFFF" FontSize="12" Margin="0,6,0,8"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="CalendarAccessBtn" Style="{StaticResource PillBtn}" Content="Ayarları aç"
                                        HorizontalAlignment="Center" Click="OpenCalendarSettings_Click"/>
                            </StackPanel>
                            <Button Grid.Row="1" Style="{StaticResource PillBtn}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                    Click="CalendarRefresh_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBlock Text="Yenile"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Kopyalananlar -->
                        <Grid x:Name="ClipPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="ClipList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}" Cursor="Hand" ToolTip="{Binding Text}"
                                                    MouseLeftButtonUp="ClipItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="10" Foreground="#66FFFFFF"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="ClipEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock x:Name="ClipEmptyText" Text="Kopyaladığınız metinler burada görünür" Foreground="#80FFFFFF"
                                           FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ClipHint" Grid.Row="1" Text="Tıklayınca yeniden kopyalanır · yalnızca bellekte tutulur"
                                       Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" Margin="2,4,0,0"/>
                            <Button x:Name="ClipClearBtn" Grid.Row="1" Style="{StaticResource PillBtn}" HorizontalAlignment="Right"
                                    Margin="0,4,0,0" Click="ClipClear_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBlock Text="Temizle"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Dosya rafı -->
                        <Grid x:Name="ShelfPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="ShelfList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}" Width="84" Height="80" Margin="0,0,6,6"
                                                    Padding="6" Cursor="Hand" ToolTip="{Binding Path}"
                                                    PreviewMouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove"
                                                    MouseRightButtonUp="ShelfItem_Remove">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="0,5,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="ShelfEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="Dosyaları çentiğe sürükleyip bırakın" Foreground="#80FFFFFF" FontSize="12"
                                           Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Dışarı sürükleyerek kopyalayın · çift tıkla aç · sağ tıkla kaldır"
                                       Style="{StaticResource Caption}" FontSize="10.5" VerticalAlignment="Center" Margin="2,4,0,0"/>
                            <Button x:Name="ShelfClearBtn" Grid.Row="1" Style="{StaticResource PillBtn}" HorizontalAlignment="Right"
                                    Margin="0,4,0,0" Click="ShelfClear_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBlock Text="Temizle"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Sistem: işlemci, bellek, ağ -->
                        <UniformGrid x:Name="SysPanel" Columns="3" Visibility="Collapsed">
                            <Border Background="#0FFFFFFF" CornerRadius="16" Padding="12,10" Margin="0,0,5,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="İşlemci" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="CpuText" Text="–" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Path x:Name="CpuSpark" Height="56" VerticalAlignment="Bottom" Fill="#26FFFFFF"
                                          Stroke="#E9E8E1" StrokeThickness="1.2" Stretch="None"/>
                                </Grid>
                            </Border>
                            <Border Background="#0FFFFFFF" CornerRadius="16" Padding="12,10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="Bellek" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="MemText" Text="–" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="MemDetail" FontSize="11" Foreground="#99FFFFFF"/>
                                    <Grid Height="6" Margin="0,14,0,0">
                                        <Border Background="#24FFFFFF" CornerRadius="3"/>
                                        <Border x:Name="MemFill" Background="#E9E8E1" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="#0FFFFFFF" CornerRadius="16" Padding="12,10" Margin="5,0,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Ağ" Style="{StaticResource Caption}"/>
                                        <TextBlock x:Name="NetDown" Text="↓ –" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="NetUp" Text="↑ –" FontSize="12" Foreground="#B3FFFFFF"/>
                                    </StackPanel>
                                    <Path x:Name="NetSpark" Height="56" VerticalAlignment="Bottom" Fill="#26FFFFFF"
                                          Stroke="#E9E8E1" StrokeThickness="1.2" Stretch="None"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Bildirimler -->
                        <Grid x:Name="NotifPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ItemsControl x:Name="NotifList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListCard}" Cursor="Hand"
                                                    ToolTip="{DynamicResource OpenAppTip}" MouseLeftButtonUp="NotifItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="2" Style="{StaticResource HeaderIconBtn}" Width="24" Height="24"
                                                            FontSize="10" VerticalAlignment="Top" Margin="8,0,0,0"
                                                            ToolTip="{DynamicResource MuteAppTip}" Click="NotifMuteApp_Click">
                                                        <TextBlock Text="&#xE7ED;"/>
                                                    </Button>
                                                    <Border Width="34" Height="34" CornerRadius="10" Background="#1AFFFFFF"
                                                            VerticalAlignment="Top">
                                                        <Grid>
                                                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="8" Margin="3" Background="Black"
                                                                    Visibility="{Binding IconVisibility}"/>
                                                            <Border CornerRadius="8" Margin="3">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}"
                                                                       FontSize="10" Foreground="#66FFFFFF"/>
                                                            <TextBlock Text="{Binding App}" FontSize="10" Foreground="#80FFFFFF"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Body}" FontSize="11.5" Foreground="#B3FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="NotifEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="22"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                                <TextBlock Text="Yeni bildirim yok" Foreground="#80FFFFFF" FontSize="12" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="NotifNoAccess" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Bildirimlere erişim izni yok" FontSize="12.5"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Ayarlar › Gizlilik › Bildirimler'den izin ver" FontSize="11"
                                           Foreground="#80FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                <Button Style="{StaticResource PillBtn}" Content="Ayarları aç"
                                        HorizontalAlignment="Center" Click="OpenNotifSettings_Click"/>
                            </StackPanel>
                            <!-- Teams bildirimleri Windows'a gelmiyorsa ipucu -->
                            <StackPanel x:Name="TeamsHint" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="0,4,90,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                <TextBlock FontSize="10.5" Foreground="#99FFFFFF" TextWrapping="Wrap" MaxWidth="300">
                                    Teams bildirimleri için: Teams › Ayarlar › Bildirimler › Bildirim stili › <Run FontWeight="SemiBold" Foreground="White">Windows</Run>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="ClearBtn" Grid.Row="1" Style="{StaticResource PillBtn}"
                                    HorizontalAlignment="Right" Margin="0,4,0,0" Click="ClearNotifs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource Icons}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,5,0"/>
                                    <TextBlock Text="Temizle"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
