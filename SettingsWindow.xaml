<Window x:Class="MSharpPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M#Pro Ayarlar" Icon="Assets/icon-64.png"
        Width="880" Height="600" MinWidth="760" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <!-- ===== Tema renkleri (kod açık/koyu temaya göre bunları değiştirir; burada koyu varsayılan) ===== -->
        <SolidColorBrush x:Key="Bg" Color="#1E211E"/>
        <SolidColorBrush x:Key="Side" Color="#181A18"/>
        <SolidColorBrush x:Key="CardBg" Color="#262A26"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2F342F"/>
        <SolidColorBrush x:Key="Ink" Color="#F2F1EB"/>
        <SolidColorBrush x:Key="Sub" Color="#9EA39C"/>
        <SolidColorBrush x:Key="Faint" Color="#6B706A"/>
        <SolidColorBrush x:Key="DividerBg" Color="#2F342F"/>
        <SolidColorBrush x:Key="Hover" Color="#2C312C"/>
        <SolidColorBrush x:Key="SelBg" Color="#2A2E2A"/>
        <SolidColorBrush x:Key="Accent" Color="#F2F1EB"/>
        <SolidColorBrush x:Key="AccentFg" Color="#222622"/>
        <SolidColorBrush x:Key="ControlBg" Color="#2A2E2A"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#3A3F3A"/>
        <SolidColorBrush x:Key="TrackOff" Color="#454B45"/>
        <SolidColorBrush x:Key="KnobOff" Color="#D6D6CF"/>
        <SolidColorBrush x:Key="PopupBg" Color="#2A2E2A"/>
        <SolidColorBrush x:Key="Screen" Color="#3A403A"/>
        <SolidColorBrush x:Key="LogoBg" Color="#222622"/>
        <SolidColorBrush x:Key="LogoFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LogoBorder" Color="#3A3F3A"/>

        <!-- ===== İnce kaydırma çubuğu ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource TrackOff}" CornerRadius="3" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Sol menü öğesi (Tag = simge) ===== -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" Margin="-12,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Hidden"/>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBg}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Parçalı seçici (tema) ===== -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="theme"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Açma / kapama anahtarı ===== -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border x:Name="track" Grid.Column="1" Width="42" Height="22" CornerRadius="11"
                                    Background="{DynamicResource TrackOff}" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="16" Height="16" Fill="{DynamicResource KnobOff}" Margin="3,0"
                                         HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="18"/>
                                <Setter TargetName="knob" Property="Height" Value="18"/>
                                <Setter TargetName="knob" Property="Margin" Value="2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Kaydırıcı ===== -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackOff}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="{DynamicResource CardBg}"
                                                         Stroke="{DynamicResource Accent}" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Açılır liste ===== -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource ControlBg}" CornerRadius="8"
                                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="{DynamicResource Sub}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="{DynamicResource PopupBg}" CornerRadius="10"
                                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                        Padding="0,4" MaxHeight="280"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Butonlar ===== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Accent}" CornerRadius="9" Padding="22,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Metin kutusu ===== -->
        <Style x:Key="DarkText" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{DynamicResource ControlBg}" CornerRadius="8"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Görünüm stili seçeneği (önizlemeli kart) ===== -->
        <Style x:Key="ShapeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="shape"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1.5" CornerRadius="12" Padding="10,10,10,8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Yardımcı stiller ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Margin" Value="4,4,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource DividerBg}"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style x:Key="LogoStroke" TargetType="Shape">
            <Setter Property="Stroke" Value="{DynamicResource LogoFg}"/>
            <Setter Property="StrokeThickness" Value="58"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ================= SOL MENÜ ================= -->
        <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource DividerBg}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <!-- Logo + ad -->
                <Grid DockPanel.Dock="Top" Margin="6,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource LogoBg}"
                            BorderBrush="{DynamicResource LogoBorder}" BorderThickness="1">
                        <Viewbox Margin="1">
                            <Canvas Width="1024" Height="1024">
                                <Polyline Points="118,761 118,261 352,599 583,261 583,761" Style="{StaticResource LogoStroke}"/>
                                <Line X1="731" Y1="352" X2="691" Y2="761" Style="{StaticResource LogoStroke}"/>
                                <Line X1="851" Y1="352" X2="813" Y2="761" Style="{StaticResource LogoStroke}"/>
                                <Line X1="653" Y1="484" X2="902" Y2="484" Style="{StaticResource LogoStroke}"/>
                                <Line X1="639" Y1="628" X2="888" Y2="628" Style="{StaticResource LogoStroke}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="M#Pro" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="Sürüm 1.0.0" FontSize="11.5"
                                   Foreground="{DynamicResource Sub}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Alt: yedekleme ve varsayılanlar -->
                <TextBlock x:Name="BackupStatus" DockPanel.Dock="Bottom" Style="{StaticResource RowDesc}" Margin="12,4,0,0"
                           Visibility="Collapsed"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <TextBlock Text="Varsayılanlara dön"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        Click="Import_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource Icons}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <TextBlock Text="Ayarları içe aktar"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <TextBlock Text="Ayarları dışa aktar"/>
                    </StackPanel>
                </Button>

                <!-- Bölümler -->
                <StackPanel>
                    <RadioButton x:Name="NavLook" Style="{StaticResource NavItem}" Tag="&#xE771;" Content="Görünüm"
                                 IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTabs" Style="{StaticResource NavItem}" Tag="&#xE8A9;" Content="Sekmeler"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBehavior" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Davranış"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavWeather" Style="{StaticResource NavItem}" Tag="&#xE753;" Content="Hava durumu"
                                 Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavUpdate" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Güncelleme"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= SAĞ: SEÇİLİ BÖLÜMÜN AYARLARI ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Margin="36,26,36,14">
                <TextBlock x:Name="PageTitle" Text="Görünüm" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDesc" Text="" FontSize="12.5" Foreground="{DynamicResource Sub}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="36,4,36,24">

                    <!-- ================= GÖRÜNÜM ================= -->
                    <StackPanel x:Name="PageLook">
                        <TextBlock Text="Uygulama" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Tema" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Sistem: Windows'ta açık mod ya da koyu mod hangisi seçiliyse"
                                               Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource ControlBg}" CornerRadius="9"
                                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="3"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystemBtn" Style="{StaticResource Segment}" Tag="&#xE7F4;"
                                                     Content="Sistem" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeLightBtn" Style="{StaticResource Segment}" Tag="&#xE706;"
                                                     Content="Açık" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="ThemeDarkBtn" Style="{StaticResource Segment}" Tag="&#xE708;"
                                                     Content="Koyu" Checked="Theme_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Dil" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Sistem: Windows Türkçe ise Türkçe, değilse İngilizce" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource ControlBg}" CornerRadius="9"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="3"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangSystemBtn" Style="{StaticResource Segment}" GroupName="lang"
                                                         Tag="&#xE7F4;" Content="Sistem" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangTrBtn" Style="{StaticResource Segment}" GroupName="lang"
                                                         Tag="&#xE775;" Content="Türkçe" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangEnBtn" Style="{StaticResource Segment}" GroupName="lang"
                                                         Tag="&#xE775;" Content="English" Checked="Lang_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DockPanel x:Name="LangRestartRow" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Yeniden başlat"
                                            Click="Restart_Click"/>
                                    <TextBlock Text="Dil, M#Pro yeniden başlatılınca değişir" Style="{StaticResource RowDesc}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Çentik" Style="{StaticResource GroupTitle}" Margin="4,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="0,12">
                                    <TextBlock Text="Görünüm stili" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Ekranın üstüne yapışık çentik ya da yüzen oval ada"
                                               Style="{StaticResource RowDesc}"/>
                                    <UniformGrid Columns="2" Margin="0,10,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                        <RadioButton x:Name="ShapeNotchBtn" Style="{StaticResource ShapeOption}" Margin="0,0,6,0"
                                                     Checked="Shape_Checked">
                                            <StackPanel>
                                                <Border Height="46" CornerRadius="8,8,4,4" Background="{DynamicResource Screen}"
                                                        ClipToBounds="True">
                                                    <Border Width="74" Height="15" Background="Black" CornerRadius="0,0,8,8"
                                                            VerticalAlignment="Top"/>
                                                </Border>
                                                <TextBlock Text="Çentik" FontSize="12.5" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ShapeIslandBtn" Style="{StaticResource ShapeOption}" Margin="6,0,0,0"
                                                     Checked="Shape_Checked">
                                            <StackPanel>
                                                <Border Height="46" CornerRadius="8,8,4,4" Background="{DynamicResource Screen}"
                                                        ClipToBounds="True">
                                                    <Border Width="74" Height="17" Background="Black" CornerRadius="8.5"
                                                            Margin="0,6,0,0" VerticalAlignment="Top"/>
                                                </Border>
                                                <TextBlock Text="Ada" FontSize="12.5" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="ClockToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Ortada saati göster" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Kompakt çentiğin ortasında saat" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Gösterileceği ekran" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="DisplayDesc" Text="Birden fazla ekran varsa" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DisplayCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="DisplayCombo_SelectionChanged"/>
                                </Grid>

                                <Border Style="{StaticResource Divider}"/>

                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Yazı tipi" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Çentikteki tüm yazılar" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="FontCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource Divider}"/>

                                <StackPanel Margin="0,12,0,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource ControlBg}" CornerRadius="6"
                                                Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScaleText" Text="%100" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Çentik boyutu" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Çentiği ve içindekileri büyütür ya da küçültür" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="A" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                                        <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource AccentSlider}" Margin="10,0"
                                                Minimum="0.8" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                LargeChange="0.1" ValueChanged="ScaleSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" Text="A" FontSize="17" Foreground="{DynamicResource Sub}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= SEKMELER ================= -->
                    <StackPanel x:Name="PageTabs" Visibility="Collapsed">
                        <TextBlock Text="Sıra ve görünürlük" Style="{StaticResource GroupTitle}"/>
                        <Border Style="{StaticResource Card}" Padding="12,6">
                            <StackPanel x:Name="TabsList"/>
                        </Border>

                        <TextBlock Text="Sekme seçenekleri" Style="{StaticResource GroupTitle}" Margin="4,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="LyricsToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Şarkı sözleri" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="LRCLIB'den zamanlı olarak alınır; bunun için şarkı adı ve sanatçı bu servise gönderilir"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="ClipToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Kopyalananlar" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Son 12 kopyalanan metin yalnızca bellekte tutulur; parola yöneticilerinin kopyaları alınmaz"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Pomodoro" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Odak ve mola süresi (dakika)" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="FocusCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="0,0,8,0"
                                              SelectionChanged="Pomodoro_SelectionChanged"/>
                                    <ComboBox x:Name="BreakCombo" Grid.Column="2" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="Pomodoro_SelectionChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= DAVRANIŞ ================= -->
                    <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" Margin="0,12"
                                          Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Bilgisayar açılınca başlat" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Windows oturumu açıldığında M#Pro otomatik çalışır" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="FullscreenToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Tam ekranda gizle" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Oyun, video veya sunum tam ekrandayken çentik görünmez" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Bildirimler ve gizleme" Style="{StaticResource GroupTitle}" Margin="4,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="MuteToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Bildirimleri sessize al" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Çentikte açılır bildirim gösterilmez; gelen bildirimler yine listede birikir"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="HiddenToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Çentiği yukarı gizle" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Gizliyken fareyi ekranın üst kenarına götürünce çentik aşağı iner; bildirimler yine görünür"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="HotkeyToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Kısayol" Style="{StaticResource RowTitle}" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <Border Style="{StaticResource KeyCap}">
                                                <TextBlock Text="Ctrl" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="+" Foreground="{DynamicResource Sub}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource KeyCap}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x229E;" FontFamily="Segoe UI Symbol" FontSize="12"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Win" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="İkisine birlikte basıp bırakınca çentik yukarı gizlenir / geri gelir"
                                                   Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Göstergeler" Style="{StaticResource GroupTitle}" Margin="4,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="OsdToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Ses ve parlaklık" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Ses ya da ekran parlaklığı değişince çentikte düzey çubuğu gösterilir"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="BatteryToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Pil" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Şarj aleti takılınca / çıkarılınca ve pil %20 ile %10'a düşünce uyarır"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="PrivacyToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Mikrofon ve kamera" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Bir uygulama kullanırken çentikte turuncu (mikrofon) ya da yeşil (kamera) nokta yanar"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="CalendarToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Takvim hatırlatıcısı" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Windows takvimindeki etkinlikten 5 dakika önce çentikte haber verir"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Sessize alınan uygulamalar" Style="{StaticResource GroupTitle}" Margin="4,10,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="0,8">
                                <TextBlock x:Name="MutedEmpty" Style="{StaticResource RowDesc}" Margin="0,4"
                                           Text="Yok. Çentikteki bildirim listesinde bir bildirimin yanındaki zil simgesiyle ekleyebilirsiniz"/>
                                <StackPanel x:Name="MutedList"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= HAVA DURUMU ================= -->
                    <StackPanel x:Name="PageWeather" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="WeatherToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Hava durumunu göster" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Müzik çalmıyorken çentikte, ayrıca panelde 'Hava' sekmesinde (30 dakikada bir yenilenir)"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>

                                <Border Style="{StaticResource Divider}"/>

                                <StackPanel x:Name="WeatherLocationBox" Margin="0,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                                Click="UseLocation_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE81D;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                                <TextBlock Text="Konumumu kullan"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Konum" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="WeatherLocText" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CitySearch" Style="{StaticResource DarkText}" KeyDown="CitySearch_KeyDown"
                                                 TextChanged="CitySearch_TextChanged"/>
                                        <TextBlock x:Name="CityPlaceholder" Text="Şehir ara (ör. Ankara)" Foreground="{DynamicResource Faint}"
                                                   FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Ara" Margin="8,0,0,0"
                                                Click="Search_Click"/>
                                    </Grid>
                                    <ComboBox x:Name="CityResults" Style="{StaticResource DarkCombo}" Margin="0,8,0,0"
                                              Visibility="Collapsed" SelectionChanged="CityResults_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= GÜNCELLEME ================= -->
                    <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStatus" Text="Güncellemeler henüz denetlenmedi"
                                                   Style="{StaticResource RowTitle}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button x:Name="InstallUpdateBtn" Style="{StaticResource AccentButton}" Content="Güncelle"
                                                Margin="0,0,8,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Click="ReleaseNotes_Click" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                                <TextBlock Text="Yenilikler"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CheckUpdateBtn" Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                                <TextBlock x:Name="CheckUpdateBtnText" Text="Şimdi denetle"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="AutoUpdateDivider" Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                                    <StackPanel>
                                        <TextBlock Text="Otomatik güncelle" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="GitHub'a yeni sürüm gelince arka planda indirir, kurar ve yeniden açar (saatte bir denetlenir)"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
