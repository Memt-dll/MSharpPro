<Window x:Class="MSharpPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M#Pro Ayarlar" Icon="Assets/icon-64.png"
        Width="470" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#FF14141C" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <!-- ===== İnce kaydırma çubuğu ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#40FFFFFF" CornerRadius="3" Margin="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Açma / kapama anahtarı ===== -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border x:Name="track" Grid.Column="1" Width="42" Height="22" CornerRadius="11"
                                    Background="#33FFFFFF" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" Margin="3,0"
                                         HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="18"/>
                                <Setter TargetName="knob" Property="Height" Value="18"/>
                                <Setter TargetName="knob" Property="Margin" Value="2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Kaydırıcı ===== -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource AccentGradient}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="White"
                                                         Stroke="{StaticResource AccentGradient}" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Koyu açılır liste ===== -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#335AB8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#1AFFFFFF" CornerRadius="8"
                                                BorderBrush="#26FFFFFF" BorderThickness="1">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                       Foreground="#99FFFFFF" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                                <Border Background="#FF20202A" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Padding="0,4" MaxHeight="280"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Butonlar ===== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentGradient}" CornerRadius="9" Padding="22,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Koyu metin kutusu ===== -->
        <Style x:Key="DarkText" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Görünüm stili seçeneği (önizlemeli kart) ===== -->
        <Style x:Key="ShapeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="shape"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1.5"
                                CornerRadius="12" Padding="10,10,10,8">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="bd" Property="Background" Value="#145AB8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Yardımcı stiller ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="4,22,0,8"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,22,24,20">

        <!-- Başlık -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="14">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/icon-64.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="M#Pro" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Text="Sürüm 1.0.0" FontSize="12" Foreground="#80FFFFFF" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ================= GÖRÜNÜM ================= -->
        <TextBlock Text="GÖRÜNÜM" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Margin="0,12">
                    <TextBlock Text="Görünüm stili" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Ekranın üstüne yapışık çentik ya da yüzen oval ada"
                               Style="{StaticResource RowDesc}"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <RadioButton x:Name="ShapeNotchBtn" Style="{StaticResource ShapeOption}" Margin="0,0,6,0"
                                     Checked="Shape_Checked">
                            <StackPanel>
                                <Border Height="46" CornerRadius="8,8,4,4" Background="#FF2B3A55" ClipToBounds="True">
                                    <Border Width="74" Height="15" Background="Black" CornerRadius="0,0,8,8"
                                            VerticalAlignment="Top" BorderBrush="#558A7CFF" BorderThickness="1,0,1,1"/>
                                </Border>
                                <TextBlock Text="Çentik" FontSize="12.5" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ShapeIslandBtn" Style="{StaticResource ShapeOption}" Margin="6,0,0,0"
                                     Checked="Shape_Checked">
                            <StackPanel>
                                <Border Height="46" CornerRadius="8,8,4,4" Background="#FF2B3A55" ClipToBounds="True">
                                    <Border Width="74" Height="17" Background="Black" CornerRadius="8.5" Margin="0,6,0,0"
                                            VerticalAlignment="Top" BorderBrush="#558A7CFF" BorderThickness="1"/>
                                </Border>
                                <TextBlock Text="Ada" FontSize="12.5" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>

                <Border Style="{StaticResource Divider}"/>

                <CheckBox x:Name="ClockToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Ortada saati göster" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Kompakt çentiğin ortasında saat" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gösterileceği ekran" Style="{StaticResource RowTitle}"/>
                        <TextBlock x:Name="DisplayDesc" Text="Birden fazla ekran varsa" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="DisplayCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                              SelectionChanged="DisplayCombo_SelectionChanged"/>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yazı tipi" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Çentikteki tüm yazılar" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="FontCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                              SelectionChanged="FontCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <StackPanel Margin="0,12,0,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="#1A5AB8FF" CornerRadius="6" Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ScaleText" Text="%100" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Çentik boyutu" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Çentiği ve içindekileri büyütür ya da küçültür" Style="{StaticResource RowDesc}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource AccentSlider}" Margin="10,0"
                                Minimum="0.8" Maximum="1.4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                LargeChange="0.1" ValueChanged="ScaleSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" Text="A" FontSize="17" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= DAVRANIŞ ================= -->
        <TextBlock Text="DAVRANIŞ" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" Margin="0,12"
                          Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Bilgisayar açılınca başlat" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Windows oturumu açıldığında M#Pro otomatik çalışır" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <CheckBox x:Name="MuteToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Bildirimleri sessize al" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Çentikte açılır bildirim gösterilmez; gelen bildirimler yine listede birikir"
                                   Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <CheckBox x:Name="HiddenToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Çentiği yukarı gizle" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Gizliyken fareyi ekranın üst kenarına götürünce çentik aşağı iner; bildirimler yine görünür"
                                   Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <CheckBox x:Name="HotkeyToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kısayol" Style="{StaticResource RowTitle}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Style="{StaticResource KeyCap}">
                                <TextBlock Text="Ctrl" FontSize="11" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="+" Foreground="#80FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KeyCap}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x229E;" FontFamily="Segoe UI Symbol" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Win" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="İkisine birlikte basıp bırakınca çentik yukarı gizlenir / geri gelir"
                                   Style="{StaticResource RowDesc}" Margin="0,4,0,0"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <CheckBox x:Name="FullscreenToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Tam ekranda gizle" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Oyun, video veya sunum tam ekrandayken çentik görünmez" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- ================= HAVA DURUMU ================= -->
        <TextBlock Text="HAVA DURUMU" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="WeatherToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Hava durumunu göster" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Müzik çalmıyorken çentikte, ayrıca panelde 'Hava' sekmesinde (30 dakikada bir yenilenir)"
                                   Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <StackPanel x:Name="WeatherLocationBox" Margin="0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                Click="UseLocation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81D;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock Text="Konumumu kullan"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Konum" Style="{StaticResource RowTitle}"/>
                            <TextBlock x:Name="WeatherLocText" Style="{StaticResource RowDesc}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CitySearch" Style="{StaticResource DarkText}" KeyDown="CitySearch_KeyDown"
                                 TextChanged="CitySearch_TextChanged"/>
                        <TextBlock x:Name="CityPlaceholder" Text="Şehir ara (ör. Ankara)" Foreground="#59FFFFFF"
                                   FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Ara" Margin="8,0,0,0"
                                Click="Search_Click"/>
                    </Grid>
                    <ComboBox x:Name="CityResults" Style="{StaticResource DarkCombo}" Margin="0,8,0,0"
                              Visibility="Collapsed" SelectionChanged="CityResults_SelectionChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= GÜNCELLEME ================= -->
        <TextBlock Text="GÜNCELLEME" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}" Margin="0,12" Click="Toggle_Click">
                    <StackPanel>
                        <TextBlock Text="Otomatik güncelle" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="GitHub'a yeni sürüm gelince arka planda indirir, kurar ve yeniden açar (saatte bir denetlenir)"
                                   Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Divider}"/>

                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateStatus" Text="Güncellemeler henüz denetlenmedi" Style="{StaticResource RowTitle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="InstallUpdateBtn" Style="{StaticResource AccentButton}" Content="Güncelle"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                        <Button x:Name="CheckUpdateBtn" Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock x:Name="CheckUpdateBtnText" Text="Şimdi denetle"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Alt kısım -->
        <Grid Margin="0,22,0,0">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Reset_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,1,6,0"/>
                    <TextBlock Text="Varsayılanlara dön"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AccentButton}" Content="Tamam" HorizontalAlignment="Right"
                    Click="Close_Click" IsDefault="True"/>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
